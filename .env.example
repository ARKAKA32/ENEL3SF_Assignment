SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only; never put the service-role key in public/config.js.
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
# Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-project-contact@example.com
PORT=3000
# Number of trusted reverse-proxy hops; omit locally.
TRUST_PROXY=
